// tsconfig.json
{
  "compilerOptions": {
    "target": "ES2020",                 // Target modern JS for Chrome
    "module": "commonjs",               // Module system (Webpack will bundle modules)
    "lib": ["DOM", "ES2020"],          // Include DOM and latest ECMAScript libs
    "strict": true,                     // Enable strict type-checking (optional, but recommended)
    "skipLibCheck": true,               // Skip type checking of declaration files
    "esModuleInterop": true,            // Allow default imports from CommonJS
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist"                    // Output compiled files to ./dist
  },
  "include": ["src/**/*.ts"]
}
